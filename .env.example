# Optional: form endpoint (e.g. https://formspree.io/f/xxxx or https://api.web3forms.com/submit).
# When unset, forms fall back to opening the visitor's email client.
VITE_FORM_ENDPOINT=
# Web3Forms access key (free). Get one at https://web3forms.com with contact@velero.capital.
VITE_WEB3FORMS_KEY=
# Contact email used for the mailto fallback and shown in the footer.
VITE_CONTACT_EMAIL=contact@velero.capital
